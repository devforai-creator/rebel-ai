# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Internal service secrets
CHAT_ADMIN_SECRET=generate_a_strong_random_token
SUMMARY_GENERATION_SECRET=generate_another_strong_random_token
CRON_SECRET=generate_a_third_strong_random_token

# Production-only internal origin
# Example: https://app.example.com
INTERNAL_API_ORIGIN=

# Optional: if Vercel Automation Protection is enabled
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: developer-only chat UI affordances (comma-separated email list)
DEVELOPER_EMAILS=your@email.com

# Optional queue/import tuning
CHAT_JOB_RUNNER_BATCH_LIMIT=2
CHARACTER_IMPORT_RUNNER_BATCH_LIMIT=1
ANTHROPIC_BATCH_CHAT_ENABLED=false
NEXT_PUBLIC_IMPORT_MAX_UPLOAD_MB=100

# Optional experimental provider-cache toggles
# For an explicit deployment profile, see env/profiles/caching.env.example
# OPENAI_PROMPT_CACHE_ENABLED=true
# OPENAI_PROMPT_CACHE_RETENTION=24h
# OPENAI_PROMPT_CACHE_MIN_TOKENS=1024
# ANTHROPIC_PROMPT_CACHE_ENABLED=true
# ANTHROPIC_PROMPT_CACHE_TTL=5m
# GOOGLE_EXPLICIT_CACHE_ENABLED=true

# Optional backfill script configuration
# Supported providers: google, openai, anthropic
BACKFILL_API_PROVIDER=google
BACKFILL_API_KEY=your_api_key_here
BACKFILL_MODEL_NAME=gemini-2.0-flash-exp
