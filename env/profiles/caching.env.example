# Optional deployment profile for provider-specific caching experiments.
#
# This file is a manual import template, not an auto-applied config source.
# Copy the values you want into your deployment environment settings, then redeploy.
# Keep summary/translation/RAG preferences in user profile settings, not here.

# OpenAI prompt cache
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_RETENTION=24h
OPENAI_PROMPT_CACHE_MIN_TOKENS=1024

# Anthropic prompt cache
ANTHROPIC_PROMPT_CACHE_ENABLED=true
ANTHROPIC_PROMPT_CACHE_TTL=5m

# Google explicit cache
GOOGLE_EXPLICIT_CACHE_ENABLED=true
