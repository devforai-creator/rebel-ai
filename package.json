{
  "name": "rebel-ai",
  "version": "0.0.0-dev",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:schema": "bash scripts/build-hosted-schema.sh",
    "db:schema:check": "bash scripts/build-hosted-schema.sh --check",
    "db:types": "supabase db push --local --yes && supabase gen types --local --schema public > src/types/database.generated.ts",
    "test": "vitest run",
    "test:rls": "bash -c 'set -euo pipefail; STATUS=$(supabase status --output json); SUPABASE_URL=$(echo \"$STATUS\" | jq -r .API_URL); SUPABASE_SERVICE_ROLE_KEY=$(echo \"$STATUS\" | jq -r .SERVICE_ROLE_KEY); SUPABASE_ANON_KEY=$(echo \"$STATUS\" | jq -r .ANON_KEY); [[ -z \"$SUPABASE_URL\" || \"$SUPABASE_URL\" == \"null\" ]] && echo \"Error: SUPABASE_URL is null - is supabase running?\" && exit 1; [[ -z \"$SUPABASE_SERVICE_ROLE_KEY\" || \"$SUPABASE_SERVICE_ROLE_KEY\" == \"null\" ]] && echo \"Error: SERVICE_ROLE_KEY is null\" && exit 1; [[ -z \"$SUPABASE_ANON_KEY\" || \"$SUPABASE_ANON_KEY\" == \"null\" ]] && echo \"Error: ANON_KEY is null\" && exit 1; SUPABASE_URL=\"$SUPABASE_URL\" SUPABASE_SERVICE_ROLE_KEY=\"$SUPABASE_SERVICE_ROLE_KEY\" SUPABASE_ANON_KEY=\"$SUPABASE_ANON_KEY\" RLS_TESTS_ENABLED=true vitest run src/lib/rls/'",
    "test:vault": "bash -lc 'set -a && source .env.local && set +a && vitest run tests/security/get_decrypted_secret.test.ts'",
    "chat:jobs": "node scripts/run-chat-jobs.js",
    "character:jobs": "node scripts/run-character-import-jobs.js",
    "import:jobs": "node scripts/run-character-import-jobs.js",
    "ops:smoke": "node scripts/first-class-smoke-check.js",
    "ops:smoke:active": "node scripts/first-class-smoke-check.js --active-runners",
    "cleanup:character-assets": "node scripts/cleanup-orphaned-character-assets.js",
    "cleanup:module-assets": "node scripts/cleanup-orphaned-module-assets.js",
    "backfill:facts": "node scripts/backfill-facts.js",
    "backfill:embeddings": "node scripts/backfill-embeddings.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.70",
    "@ai-sdk/deepseek": "^1.0.35",
    "@ai-sdk/google": "^2.0.62",
    "@ai-sdk/openai": "^2.0.99",
    "@google/generative-ai": "^0.24.1",
    "@msgpack/msgpack": "^3.1.2",
    "@safe-ugc-ui/react": "^2.1.1",
    "@supabase/ssr": "~0.5.2",
    "@supabase/supabase-js": "~2.76.1",
    "ai": "^5.0.154",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "next": "^15.5.15",
    "re2js": "^1.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tus-js-client": "^4.3.1",
    "voyageai": "^0.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.14",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.9",
    "prettier": "^3.7.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.4"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "parse5": "7.1.2",
    "qs": "^6.14.1"
  }
}
